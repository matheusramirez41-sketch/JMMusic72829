{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "JMMUSIC",
  "short_name": "JMMUSIC",
  "description": "JMMUSIC: Reproductor de música en alta fidelidad con letras sincronizadas, ecualizador de 10 bandas y modo sin internet.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "portrait-primary",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "es",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["music", "entertainment", "audio"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "JMMUSIC Pantalla Móvil"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "JMMUSIC Pantalla Escritorio"
    }
  ]
}
